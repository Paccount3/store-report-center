# Server-side only. Never put this key in client code or commit a real value.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Required for Vercel (and any host without a writable local disk).
# Create a free database at https://turso.tech then paste the URL and token here / in Vercel env vars.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional local override. Defaults to ./data when Turso is not set.
# DATA_DIR=
