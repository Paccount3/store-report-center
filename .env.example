# Server-side only. Never put this key in client code or commit a real value.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional. Absolute path for SQLite and uploads. Defaults to ./data
# On Vercel the filesystem is ephemeral; see README for production notes.
# DATA_DIR=/tmp/goodwill-report-center
